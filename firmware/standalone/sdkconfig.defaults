# ChatAI TPIOS standalone firmware target.
# Use ESP-IDF's 1.5 MB single-app layout; flash size remains unset until
# the physical board is verified. This layout does not provide OTA slots.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Required for Gemini Live WSS certificate verification.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DEFAULT_CERTIFICATE_BUNDLE=y
