# ChatAI TPIOS standalone firmware target.
# Preserve the 16 MB Xiaozhi-era layout so the installed bootloader and
# existing OTA slots remain compatible during migration to standalone.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Required for Gemini Live WSS certificate verification.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Validate X.509 certificate validity dates only after SNTP synchronization.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# Enable targeted MbedTLS handshake diagnostics while preserving certificate verification.
CONFIG_MBEDTLS_DEBUG=y
CONFIG_MBEDTLS_DEBUG_LEVEL_INFO=y

# MINI ESP32-S3 N16R8: use the onboard 8 MB octal PSRAM for large buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# A/B test: restore the pre-ed01963 internal-first allocation thresholds.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Let MbedTLS follow ESP-IDF malloc policy (large TLS buffers can use PSRAM).
# Do not force all TLS allocations into external RAM.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y


# BLE passive scanner for the Web Admin Bluetooth Tool (NimBLE observer only).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ESP32-S3 shares one 2.4 GHz RF module between Wi-Fi and BLE.
# Per Espressif coexistence guidance, isolate protocol-stack scheduling:
# Wi-Fi driver on Core 0; Bluetooth Controller and NimBLE Host on Core 1.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_BT_CTRL_PINNED_TO_CORE_1=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
